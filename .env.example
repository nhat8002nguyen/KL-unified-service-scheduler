# Copy to .env for local `docker compose` / `npm run dev`.
PORT=8080

# For the app running on the host, the compose db is published on 5433.
DATABASE_URL=postgres://keyloop:keyloop@localhost:5433/keyloop

LOG_LEVEL=info

# Leave empty to disable OTLP export (tracing still generates ids).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hold TTL for a reserved slot (minutes).
HOLD_MINUTES=10
